# Secrets: never commit
Config/Secrets.xcconfig
.env
.env.*
*.p12
*.mobileprovision
*.key
*.pem

# Generated by XcodeGen
*.xcodeproj
App/Info.plist

# The Gemini-rendered clips and their manifest.json are committed, so every archive ships the same
# voice without a key. Clips from `render_phrases.py --engine say` are rehearsal only, since macOS
# voice output may not be redistributable: never commit those. verify.json is a local cache.
App/Resources/phrases/*.caf
App/Resources/phrases/verify.json
App/Resources/phrases/.*.tmp

# Build output
__pycache__/
.build/
.swiftpm/
DerivedData/
xcuserdata/
*.xcuserstate

# Volunteer and rehearsal media
evals/private/
*.mov
*.mp4
# Except the grip reminder the app plays as CPR starts, which the build needs.
!Packages/RescueVision/Sources/RescueVision/Resources/GripReminder.mp4

.DS_Store
