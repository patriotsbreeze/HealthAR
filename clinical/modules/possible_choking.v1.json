  "phrases": [
    {
      "id": "choke_ask",
      "text": "Possible choking. Can they cough or speak?",
      "citation": "AHA 2025 Part 7, choking, severe signs"
    },
    {
      "id": "choke_keep_coughing",
      "text": "Let them keep coughing. Stay close. Tap if they can't cough.",
      "citation": "AHA 2025 Part 7, choking, mild: encourage coughing"
    },
    {
      "id": "choke_calling",
      "text": "Calling 911 for you.",
      "citation": "AHA 2025 Part 7, activate EMS. Project design: the 911 agent places the call in the background, simulated in this build"
    },
    {
      "id": "choke_blows",
      "text": "Lean them forward. Five firm blows between the shoulder blades.",
      "citation": "AHA 2025 Part 7, choking, 5 back blows with the heel of the hand"
    },
    {
      "id": "choke_thrusts_line",
      "text": "Fist just above the navel. Five quick thrusts, in and up.",
      "citation": "AHA 2025 Part 7, choking, 5 abdominal thrusts"
    },
    {
      "id": "choke_repeat",
      "text": "Repeat until it's out. If they collapse, tap Not responding.",
      "citation": "AHA 2025 Part 7, choking, repeat until expelled or unresponsive"
    },
    {
      "id": "choke_after",
      "text": "Good. Stay with them. They still need to be checked by EMS.",
      "citation": "AHA 2025 Part 7, choking: anyone given abdominal thrusts needs evaluation"
    }
  ]
