  "phrases": [
    { "id": "limb_possible", "text": "Possible broken bone. Keep it as found.", "citation": "AHA 2024, 2b C-EO" },
    { "id": "limb_danger_ask", "text": "Heavy bleeding? Neck or back pain? Limb blue or pale?", "citation": "AHA 2024, 1 C-EO" },
    { "id": "limb_danger_care", "text": "Press hard on any bleeding, cloth if handy. Keep them still.", "citation": "AHA 2024, 1 C-LD and 1 C-EO. The cloth is a proposal, after ACS Stop the Bleed" },
    { "id": "limb_tourniquet", "text": "If pressure does not stop it, tighten a tourniquet above the wound.", "citation": "AHA 2024, 1 B-NR" },
    { "id": "limb_gloves", "text": "Put gloves on only if they're in reach. Don't delay pressure.", "citation": "American Red Cross First Aid/CPR/AED: gloves if available, never delay care for them. Proposal, needs clinician approval" },
    { "id": "limb_wound", "text": "Cover open wounds with clean cloth.", "citation": "AHA 2024, 2b C-EO. Cloth for a dressing is a proposal" },
    { "id": "limb_support", "text": "Don't straighten it. Pad under it: towel, pillow.", "citation": "AHA 2024, 2a C-EO, and position found 2b C-EO. Materials are a proposal" },
    { "id": "limb_seek_care", "text": "They need medical care. Call 911 if unsure or it gets worse.", "citation": "AHA 2024, 1 C-EO" }
  ]
